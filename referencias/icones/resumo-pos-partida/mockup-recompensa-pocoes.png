\":1},\"is_device_based\":false,\"passed\":false},\"3701585807\":{\"name\":\"3701585807\",\"rule_id\":\"4V4CgF1TPMJrczjAfIZIOn:100.00:6-4V4CgDmRnuzWT9LEEB45vl\",\"secondary_exposures\":[],\"version\":14,\"id_type\":\"userID\",\"value\":{\"buckets\":[{\"categories\":[\"SHOPPING\",\"FOOD\",\"ENTERTAINMENT\",\"TRAVEL\",\"LIFESTYLE\",\"NEWS\"],\"id\":\"lifestyle\",\"name\":\"Lifestyle\"},{\"name\":\"Productivity\",\"id\":\"productivity\",\"categories\":[\"EDUCATION\",\"DESIGN\",\"BUSINESS\",\"DEVELOPER_TOOLS\",\"PRODUCTIVITY\",\"COLLABORATION\",\"FINANCE\"]}],\"categories\":[{\"id\":\"SHOPPING\",\"name\":\"Shopping\"},{\"name\":\"Food\",\"id\":\"FOOD\"},{\"name\":\"Entertainment\",\"id\":\"ENTERTAINMENT\"},{\"name\":\"Education\",\"id\":\"EDUCATION\"},{\"name\":\"Design\",\"id\":\"DESIGN\"},{\"id\":\"BUSINESS\",\"name\":\"Business\"},{\"name\":\"Developer Tools\",\"id\":\"DEVELOPER_TOOLS\"},{\"id\":\"PRODUCTIVITY\",\"name\":\"Productivity\"},{\"name\":\"Collaboration\",\"id\":\"COLLABORATION\"},{\"id\":\"FINANCE\",\"name\":\"Finance\"},{\"id\":\"TRAVEL\",\"name\":\"Travel\"},{\"name\":\"Lifestyle\",\"id\":\"LIFESTYLE\"}]},\"is_device_based\":false,\"passed\":true},\"216497991\":{\"name\":\"216497991\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":15,\"id_type\":\"userID\",\"value\":{\"max_file_size_mb\":5,\"outdated_room_bootstrap_messages_count\":10,\"sidebar_pagination_page_size\":6,\"idle_room_navigation_timeout_s\":900,\"max_pinned_room_count\":2,\"sidebar_default_recent_room_row_count\":3},\"is_device_based\":false,\"passed\":false},\"548821362\":{\"name\":\"548821362\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":3,\"id_type\":\"userID\",\"value\":{\"eligible_upsell_context_ids\":[\"codex\",\"image_gen\"]},\"is_device_based\":false,\"passed\":false},\"3254894752\":{\"name\":\"3254894752\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":11,\"id_type\":\"userID\",\"value\":{\"url\":\"https://help.openai.com/articles/20001047-ads-in-chatgpt#ads-free-on-the-chatgpt-free-plan\"},\"is_device_based\":false,\"passed\":false},\"2613464472\":{\"name\":\"2613464472\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":55,\"id_type\":\"workspace_id\",\"value\":{\"rosalind\":\"hidden\",\"luna\":\"hidden\",\"daybreak_red\":\"hidden\",\"terra\":\"hidden\",\"sol\":\"hidden\",\"daybreak\":\"hidden\"},\"is_device_based\":false,\"passed\":false},\"1977158438\":{\"name\":\"1977158438\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":4,\"id_type\":\"userID\",\"value\":{\"enable_web_search\":false,\"system_prompt\":\"The user is asking about an ad shown to them by {advertiser}. Your response must be about the ad shown. They are using the \\\"Ask ChatGPT\\\" feature to get ChatGPT's honest opinion on the product(s) in the advertisement, and in which situations it could be a great fit for them. You should be honest about when you think the product(s) would vs. would not be useful for the user, based on what you know about them.\\n\\nInformation about the ad:\\n{ad}.\\n\\nStructure your response in the following manner:\\n- Briefly describe the type of user, use case, or situation where this ad/product makes sense for the user.\\n- If appropriate, explain any mismatches with the user's stated preferences or goals. That is, where might it fall short for the user (if appropriate)? You don't have to do this for every query, but feel free to list limitations if you think they're pretty relevant.\\n- Give a concise recommendation (e.g., \\\"worth considering,\\\" \\\"probably not ideal,\\\" \\\"good budget option,\\\" \\\"seriously may be a fit,\\\" etc.)\\n\\nGuidelines:\\n- Be honest and practical.\\n- Do not blindly promote the ad.\\n- Avoid harsh or absolute negative language.\\n- Do not invent details not present in the ad.\\n- Focus on fit, not feature lists.\\n- If the mark on relevance is clearly missed, feel free to be funny with it and keep it lighthearted. Do not mock the user or advertiser; keep the humor gentle.\\n\\nKeep it concise, direct, and easy to scan.\\n\\n{conversation}\",\"user_prompt_key\":\"good_option\"},\"is_device_based\":false,\"passed\":false},\"2889497622\":{\"name\":\"2889497622\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":21,\"id_type\":\"userID\",\"value\":{\"enabled\":true,\"requested_model_slugs\":[\"gpt-5-5-pro\",\"gpt-5-5-thinking\",\"gpt-5-6-pro\"]},\"is_device_based\":false,\"passed\":false},\"3528236309\":{\"name\":\"3528236309\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":84,\"id_type\":\"userID\",\"value\":{\"show_weekly_active_users_chart\":true,\"show_benchmark\":true,\"show_group_filter\":true,\"can_see_analytics_viewer_role\":true,\"show_project_overview_chart\":true,\"show_project_tab\":true,\"show_conversation_topic\":true,\"show_ui_polish\":true,\"custom-time-range-selector\":true,\"show_ai_champions_button\":true,\"show_benchmark_tab\":true,\"show_connector_overview_chart\":true,\"show_connector_project_cols\":true,\"show_classification_tab\":true,\"show_impact_tab\":true,\"temp-sidebar-chat\":true},\"is_device_based\":false,\"passed\":false},\"635008376\":{\"name\":\"635008376\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"3612242227\",\"gateValue\":\"true\",\"ruleID\":\"2Y3kdFl1HVF2xBzA7MH25u:2.00:1\"},{\"gate\":\"2831404950\",\"gateValue\":\"false\",\"ruleID\":\"2WDk2DdVIt6UBFBcGukiEI\"}],\"version\":5,\"id_type\":\"userID\",\"value\":{\"show_see_all_plans_button\":\"disabled\"},\"is_device_based\":false,\"passed\":false},\"3934129380\":{\"name\":\"3934129380\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":36,\"id_type\":\"userID\",\"value\":{\"model\":\"gpt-4o\"},\"is_device_based\":false,\"passed\":false},\"112877228\":{\"name\":\"112877228\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"1007700932\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":110,\"id_type\":\"userID\",\"value\":{\"